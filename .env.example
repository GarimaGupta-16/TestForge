# Supabase Public Configuration (Safe for Next.js client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-actual-publishable-or-anon-key

# GitHub App Integration (Server-only - Fine-grained Repository Permissions)
# Note: Do NOT use GitHub OAuth App credentials here.
# Note: Do NOT expose these variables with NEXT_PUBLIC_ prefix.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=

# Gemini AI Provider Configuration (Server-only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_PROVIDER=gemini

